# WEBHOOK_URL: The target endpoint for result submission
WEBHOOK_URL="https://your-webhook-api.com/submit"

# JWT_SECRET: Private key for signing tokens
JWT_SECRET="your-256-bit-secret"

# JWT_AUDIENCE: Audience for the token
JWT_AUDIENCE="your-audience"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
